# Supabase — copie ce fichier en `.env.local` puis remplace les
# placeholders par tes vraies clés (Dashboard Supabase → Project
# Settings → API).
#
# IMPORTANT : sur Vercel, ajoute les mêmes variables dans
# Dashboard → Settings → Environment Variables pour Production +
# Preview + Development, sinon le build échoue.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optionnel : webhook Discord pour recevoir les feedbacks in-app.
# Crée-le dans ton serveur Discord : Paramètres du salon → Intégrations
# → Webhooks → Nouveau webhook → copie l'URL.
# Si vide, le bouton 💬 ouvre un mailto sur melvin.bruhat@gmail.com.
VITE_DISCORD_FEEDBACK_WEBHOOK=
